# Copy to .env.prod on the VPS (chmod 600). Never commit .env.prod.
# Generate secrets on the server, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# PostgreSQL (own container, own volume; not shared with other projects)
POSTGRES_DB=banklab
POSTGRES_USER=banklab
POSTGRES_PASSWORD=change-me

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=BANKLAB_DOMAIN
CSRF_TRUSTED_ORIGINS=https://BANKLAB_DOMAIN
CORS_ALLOWED_ORIGINS=https://BANKLAB_DOMAIN
TIME_ZONE=Africa/Mogadishu

# Behind nginx + Cloudflare. nginx sets X-Real-IP from CF-Connecting-IP and
# X-Forwarded-Proto from CF-Visitor.
CLIENT_IP_HEADER=HTTP_X_REAL_IP
# nginx sends this in X-BankLab-Proxy; without it Django ignores X-Real-IP and
# X-Forwarded-Proto (other containers on the shared proxy network can reach the API).
PROXY_SHARED_SECRET=change-me
DJANGO_TRUST_PROXY_PROTO=true
# Cloudflare "Always use HTTPS" does the redirect; a Django redirect would
# loop in Cloudflare "Flexible" mode.
DJANGO_SSL_REDIRECT=false
# Raise to 31536000 only after HTTPS works everywhere on this domain.
DJANGO_HSTS_SECONDS=0

# Gunicorn (tune after the load test)
GUNICORN_WORKERS=4
GUNICORN_THREADS=4

# Compose wiring
PROXY_NETWORK=change-me
API_PORT=8100
WEB_PORT=3100
